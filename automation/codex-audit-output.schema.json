{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed",
    "verification_commands",
    "question"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "noop", "question", "error"]
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": ["string", "null"]
    }
  }
}
